# Optional. Only needed when self-hosting.
# Users can always bring their own key from the in-app AI settings; the key is sent
# with each request and never stored on the server. These are a fallback for
# requests that come without a key. Leave them empty on a public deployment,
# otherwise every visitor uses (and bills) your key.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Google Gemini (free tier available) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
